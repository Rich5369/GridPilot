    {
      "category": "led",
      "title": "LED lighting replacement",
      "eligibility": "Existing lighting with an equivalent replacement",
      "business_types": [
        "commercial; equipment evidence determines applicability"
      ],
      "required_inputs": [
        "fixture_count",
        "old_watts",
        "new_watts",
        "hours_per_day",
        "days_per_year",
        "equivalent_service_confirmed"
      ],
      "optional_inputs": [
        "rate",
        "installation_cost_usd",
        "annual_incremental_cost_usd"
      ],
      "calculation_method": "fixture_count * (old_watts - new_watts) / 1000 * hours_per_day * days_per_year",
      "sources": [
        "https://www.energy.gov/energysaver/led-lighting"
      ],
      "data_quality_requirements": "Document source, units, equivalent service and baseline period; no nameplate-only consumption claims.",
      "implementation_complexity": "medium",
      "numerical_savings_supported": true
    },
